{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/.netlify/functions/api",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?action=$1"
    },
    {
      "src": "/api",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/cardapio",
      "dest": "/cardapio.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
